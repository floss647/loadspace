---
// Shared layout for calculators: dark header, inputs on the left, live results on the right.
import Base from './Base.astro';
const { title, metaTitle, description, eyebrow = 'Free tool', lede, crumb = ['/tools/', 'Tools'], icon, appCategory = 'FinanceApplication' } = Astro.props;
const hasResults = Astro.slots.has('results');
import NewsletterBox from '../components/NewsletterBox.astro';
import { orgRef } from '../lib/seo.js';
// A free calculator or check that runs in the browser.
const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  applicationCategory: appCategory,
  operatingSystem: 'Any (runs in a web browser)',
  browserRequirements: 'Requires JavaScript.',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  inLanguage: 'en-GB',
  publisher: orgRef(Astro.site),
};
---
<Base title={metaTitle || title} description={description} jsonLd={ld} crumbs={[['Home', '/'], [crumb[1], crumb[0]]]} crumbName={title}>
  <section class="tool-hero">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> › <a href={crumb[0]}>{crumb[1]}</a></div>
      <div class="tool-hero-row">
        {icon && <span class="tool-hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icon} /></svg></span>}
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          {lede && <p class="review-summary">{lede}</p>}
        </div>
      </div>
      <slot name="hero" />
    </div>
  </section>
  <div class={hasResults ? 'wrap tool-shell' : 'wrap tool-shell single'}>
    <div class="tool-inputs"><slot name="inputs" /></div>
    {hasResults && <aside class="tool-results" aria-live="polite"><slot name="results" /></aside>}
  </div>
  <div class="wrap"><div class="prose tool-notes"><slot /></div></div>
  <div class="wrap"><NewsletterBox source="tool" /></div>
</Base>
