---
import Base from './Base.astro';
import VehicleImage from '../components/VehicleImage.astro';
import { fmtDate } from '../lib/news.js';
import { SITE } from '../data/site.js';
import { EV_VANS } from '../data/vans.js';
import { scoreSpecs } from '../lib/review-score.js';
import IMAGES from '../data/images.json';
const { frontmatter: f } = Astro.props;
const van = EV_VANS.find((v) => v.slug === f.van);
const name = van?.name || f.van;
const { rows, overall, scoredCount } = scoreSpecs(f.specs);
const img = IMAGES[f.van];
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: f.title,
  description: f.summary,
  datePublished: new Date(f.date).toISOString(),
  inLanguage: 'en-GB',
  mainEntityOfPage: pageUrl,
  image: img?.file ? [new URL(img.file, Astro.site).href] : undefined,
  author: { '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).href } },
};
---
<Base title={f.title} description={f.summary} image={img?.file} type="article" jsonLd={ld}>
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a> › <a href="/reviews/">Reviews</a></div>
    <article class="prose review">
      <p class="small muted" style="margin:0 0 .4rem">{fmtDate(f.date)} · <span class="tag">Review roundup</span></p>
      <h1>{f.title}</h1>
      <VehicleImage slug={f.van} name={name} />
      <p class="lede">{f.summary}</p>

      <div class="verdict-box">
        <div class="verdict-score" aria-label={`Loadspace data score ${overall} out of 5`}>
          <span class="big">{overall?.toFixed(1)}</span><span class="of">/5</span>
          <span class="small">Loadspace data score</span>
        </div>
        <div>
          <h2>Our verdict</h2>
          <p>{f.verdict}</p>
          <div class="good-bad">
            <div><strong>Good</strong><ul>{f.good?.map((g) => <li>{g}</li>)}</ul></div>
            <div><strong>Not so good</strong><ul>{f.bad?.map((b) => <li>{b}</li>)}</ul></div>
          </div>
        </div>
      </div>

      <h2>The numbers we scored</h2>
      <div class="table-wrap">
        <table class="score-table">
          <thead><tr><th>What</th><th>{name}</th><th class="num">Score</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{r.label}<br /><span class="muted small">{r.what}</span></td>
                <td>{r.value ?? 'Not confirmed yet'}</td>
                <td class="num"><span class="pips" aria-label={`${r.points ?? 0} out of 5`}>{[1, 2, 3, 4, 5].map((n) => <i class={n <= (r.points ?? 0) ? 'on' : ''} />)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {scoredCount < rows.length && <p class="notice small">We couldn't confirm every figure from a current source, so this score is the average of the {scoredCount} we could. We'll add the rest when they're confirmed.</p>}
      <p class="small muted">Scored only from published specs, so vans can be compared fairly. <a href="/reviews/how-we-score/">How we score</a>.</p>

      <h2>What the testers say</h2>
      <p class="notice small"><strong>This is a roundup, not our own road test.</strong> We've read the published UK reviews and summarised them in our own words, saying who thinks what. We haven't driven this van ourselves yet.</p>
      <slot />

      {f.corrections?.length > 0 && (
        <div class="notice small" id="corrections">
          <strong>Corrections</strong>
          <ul>{f.corrections.map((c) => <li>{fmtDate(c.date)}: {c.text}</li>)}</ul>
        </div>
      )}
      <p class="small muted">Every figure and every reviewer's opinion here was checked against its original source before publishing. Spotted a mistake? <a href="/corrections/">Tell us</a> and we'll correct it openly.</p>
      <p class="small">{van && <><a href={`/vans/${van.slug}/`}>{name}: buyer's guide, running costs and charging →</a><br /></>}<a href="/reviews/">More reviews →</a></p>
    </article>
  </div>
</Base>
