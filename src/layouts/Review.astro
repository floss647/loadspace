---
import Base from './Base.astro';
import VehicleImage from '../components/VehicleImage.astro';
import { fmtDate } from '../lib/news.js';
import { SITE } from '../data/site.js';
import { EV_VANS, SIZES } from '../data/vans.js';
import { scoreSpecs } from '../lib/review-score.js';
import IMAGES from '../data/images.json';
const { frontmatter: f } = Astro.props;
const van = EV_VANS.find((v) => v.slug === f.van);
const name = van?.name || f.van;
const { rows, overall, scoredCount } = scoreSpecs(f.specs);
const img = IMAGES[f.van];
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: f.title,
  description: f.summary,
  datePublished: new Date(f.date).toISOString(),
  inLanguage: 'en-GB',
  mainEntityOfPage: pageUrl,
  image: img?.file ? [new URL(img.file, Astro.site).href] : undefined,
  author: { '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).href } },
};
---
<Base title={f.title} description={f.summary} image={img?.file} type="article" jsonLd={ld}>
  <section class="review-hero">
    <div class="wrap review-hero-grid">
      <div class="review-hero-copy">
        <div class="crumbs"><a href="/">Home</a> › <a href="/reviews/">Reviews</a>{van && <> › {SIZES[van.size]?.label}</>}</div>
        <p class="eyebrow">Loadspace review · {fmtDate(f.date)}</p>
        <h1>{f.title}</h1>
        <p class="review-summary">{f.summary}</p>
        {overall == null && (
          <div class="review-medal"><span class="medal-label"><strong>Not scored yet</strong>We could only confirm {scoredCount} of {rows.length} figures from current sources</span></div>
        )}
        {overall != null && (
          <div class="review-medal">
            <span class="medal-score">{overall.toFixed(1)}<small>/5</small></span>
            <span class="medal-label"><strong>Loadspace data score</strong>Scored on {scoredCount} of {rows.length} published figures</span>
          </div>
        )}
      </div>
      <div class="review-photo"><VehicleImage slug={f.van} name={name} /></div>
    </div>
  </section>

  <div class="wrap review-grid">
    <article class="prose review-body">
      <div class="verdict-callout">
        <p class="eyebrow">Our verdict</p>
        <p>{f.verdict}</p>
      </div>
      <div class="good-bad">
        <div class="gb good"><h3>Good</h3><ul>{f.good?.map((g) => <li>{g}</li>)}</ul></div>
        <div class="gb bad"><h3>Not so good</h3><ul>{f.bad?.map((b) => <li>{b}</li>)}</ul></div>
      </div>

      <h2>Our review</h2>
      <slot />

      <p class="review-method small muted"><strong>How we reviewed it:</strong> we haven't road-tested this van ourselves yet. This review is our own judgement, based on the maker's published figures and price lists and the UK road tests published so far. Every figure was checked against its source before publishing. <a href="/reviews/how-we-score/">How we review and score</a>.</p>
      {f.corrections?.length > 0 && (
        <div class="notice small" id="corrections">
          <strong>Corrections</strong>
          <ul>{f.corrections.map((c) => <li>{fmtDate(c.date)}: {c.text}</li>)}</ul>
        </div>
      )}
      <p class="small muted">Spotted a mistake? <a href="/corrections/">Tell us</a> and we'll correct it openly.</p>
    </article>

    <aside class="review-aside">
      <div class="score-card">
        <div class="score-card-head">
          {overall != null ? <span class="medal-score">{overall.toFixed(1)}<small>/5</small></span> : <span class="medal-score">n/a</span>}
          <span><strong>Data score</strong><br /><span class="small muted">{overall != null ? 'From published specs' : `Needs at least 3 confirmed figures`}</span></span>
        </div>
        <ul class="score-rows">
          {rows.map((r) => (
            <li>
              <div class="score-row-top"><span>{r.label}</span><strong>{r.points != null ? `${r.points}/5` : 'n/a'}</strong></div>
              <div class="meter" aria-hidden="true">{[1, 2, 3, 4, 5].map((n) => <i class={n <= (r.points ?? 0) ? 'on' : ''} />)}</div>
              <div class="score-value">{r.points != null ? r.value : 'Not confirmed yet'}</div>
            </li>
          ))}
        </ul>
        {overall != null && scoredCount < rows.length && <p class="small muted score-note">We couldn't confirm every figure from a current source, so the score averages the {scoredCount} we could.</p>}
        {overall == null && <p class="small muted score-note">We could only confirm {scoredCount} of {rows.length} figures from current sources, so we haven't scored this van yet.</p>}
        <a class="small" href="/reviews/how-we-score/">How we score →</a>
      </div>
      <div class="aside-links">
        {van && <a class="btn" href={`/vans/${van.slug}/`}>{name} buyer's guide</a>}
        <a class="btn secondary" href="/tools/electric-vs-diesel/">Electric vs diesel costs</a>
        <a class="btn secondary" href="/reviews/">All reviews</a>
      </div>
    </aside>
  </div>
</Base>
