---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
import { VANS } from '../data/vans.js';
import { TRUCKS } from '../data/trucks.js';

const evVans = VANS.filter((v) => v.electric).length;
---
<Base>
  <section class="hero">
    <div class="wrap">
      <h1>{SITE.tagline}</h1>
      <p>Independent advice on electric vans and trucks, new and used. Whether to switch, which one to buy, what it really costs, and how to charge it. For one-van traders and fleets alike.</p>
      <div class="btn-row">
        <a class="btn" href="/tools/electric-vs-diesel/">Will electric save me money?</a>
        <a class="btn secondary" href="/vans/">Browse electric vans</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <h2>Where are you starting?</h2>
    <div class="grid">
      <a class="card" href="/guides/should-i-go-electric/">
        <h3>I run a van for my business</h3>
        <p>Should you switch, which van suits your work, and whether to lease or buy.</p>
      </a>
      <a class="card" href="/fleets/">
        <h3>I manage a fleet</h3>
        <p>Total cost, depot charging, grants, and a step-by-step plan for electrifying vans and trucks.</p>
      </a>
      <a class="card" href="/used-electric-vans/">
        <h3>I want a used electric van</h3>
        <p>Battery health, real range, which models to look for, and the traps on older vans.</p>
      </a>
    </div>

    <h2>Electric vans and trucks</h2>
    <div class="grid">
      <a class="card" href="/vans/#small"><h3>Small electric vans</h3><p>City work and sole traders. The cheapest way to go electric.</p></a>
      <a class="card" href="/vans/#medium"><h3>Medium electric vans</h3><p>The all-rounders. Most trades start here.</p></a>
      <a class="card" href="/vans/#large"><h3>Large electric vans</h3><p>Couriers, builders and multi-drop. Up to 4.25 tonnes on a car licence.</p></a>
      <a class="card" href="/vans/#pickup"><h3>Electric pickups</h3><p>The first fully electric pickups arrived in the UK in 2026.</p></a>
      <a class="card" href="/trucks/"><h3>Electric trucks</h3><p>{TRUCKS.length} models from 7.5-tonne delivery trucks to 44-tonne tractor units.</p></a>
    </div>
    <p class="small muted">{evVans} electric vans and pickups are on sale in the UK. <a href="/vans/no-electric-version/">Some popular vans still have no electric version</a>.</p>

    <div class="grid" style="margin-top:2rem">
      <a class="card" href="/get-charger-quotes/" style="border-left:4px solid var(--accent)"><h3>Get charger quotes</h3><p>Home or depot charging from vetted installers.</p></a>
      <a class="card" href="/fleets/enquiry/" style="border-left:4px solid var(--accent)"><h3>Fleet enquiry</h3><p>Help planning a switch for your vans or trucks.</p></a>
    </div>

    <h2>Tools</h2>
    <div class="grid">
      <a class="card" href="/tools/electric-vs-diesel/"><h3>Electric vs diesel cost</h3><p>Your yearly running costs side by side.</p></a>
      <a class="card" href="/tools/fleet-cost/"><h3>Fleet switch calculator</h3><p>What going electric saves across your whole fleet, and how long it takes to pay back.</p></a>
      <a class="card" href="/tools/lease-or-buy/"><h3>Lease, buy new or buy used?</h3><p>Compare all three over the years you'll keep the van, with or without VAT.</p></a>
      <a class="card" href="/tools/van-check/"><h3>Free van check</h3><p>MOT history, mileage and tax for any UK van by registration.</p></a>
      <a class="card" href="/reliability/"><h3>Most reliable vans</h3><p>MOT failure rates by model from official DVSA data.</p></a>
      <a class="card" href="/tools/lease-true-cost/"><h3>Lease true-cost calculator</h3><p>What a "6+35" deal really costs per month.</p></a>
    </div>

    <h2>Start with the basics</h2>
    <div class="grid">
      <a class="card" href="/guides/should-i-go-electric/"><h3>Should I go electric?</h3><p>Who it suits, who it doesn't, and the numbers that decide it.</p></a>
      <a class="card" href="/guides/charging-an-electric-van/"><h3>Charging an electric van</h3><p>At home, at the depot and on the road, and what each costs.</p></a>
      <a class="card" href="/guides/grants-and-tax/"><h3>Grants and tax</h3><p>Plug-in van and truck grants, VAT, company van tax and more.</p></a>
      <a class="card" href="/guides/used-electric-van-buying-guide/"><h3>Buying a used electric van</h3><p>The checks that matter before you hand over money.</p></a>
    </div>
  </div>
</Base>
