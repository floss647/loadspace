---
import Base from '../../layouts/Base.astro';
import { POSTS, fmtDate } from '../../lib/news.js';
const [lead, ...rest] = POSTS;
const card = (p) => p.img?.image.replace('/news/', '/news/card/');
---
<Base title="Electric van and truck news" description="The latest UK news on electric vans and trucks: sales, grants, new models, policy and what it means for buyers and fleets.">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Checked against the source, every time</p>
      <h1>News</h1>
      <p class="lede">What's changing for electric van and truck buyers in the UK, and what it means for you.</p>
    </div>
  </header>
  <div class="wrap">
    {lead && (
      <div class="news-feature" style="margin-bottom:2.5rem">
        <a class="lead-story" href={lead.url}>
          {lead.img && <img src={lead.img.image} alt="" width="1600" height="900" />}
        </a>
        <a class="lead-story lead-text" href={lead.url} style="align-self:center">
          <p class="meta">{lead.tag && <span class="pill">{lead.tag}</span>}{fmtDate(lead.date)}</p>
          <h3>{lead.title}</h3>
          <p>{lead.summary}</p>
        </a>
      </div>
    )}
    <div class="mag-grid">
      {rest.map((p) => (
        <a class="mag-card" href={p.url}>
          {p.img && <img src={card(p)} alt="" loading="lazy" width="800" height="450" />}
          <p class="meta">{p.tag && <span class="pill">{p.tag}</span>}{fmtDate(p.date)}</p>
          <h3>{p.title}</h3>
          <p class="sum">{p.summary}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
