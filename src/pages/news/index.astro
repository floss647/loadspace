---
import Base from '../../layouts/Base.astro';
import { POSTS, fmtDate } from '../../lib/news.js';
---
<Base title="Electric van and truck news" description="The latest UK news on electric vans and trucks: sales, grants, new models, policy and what it means for buyers and fleets.">
  <div class="wrap">
    <h1>News</h1>
    <p class="lede">What's changing for electric van and truck buyers in the UK, and what it means for you.</p>
    <div class="news-list">
      {POSTS.map((p) => (
        <a class="card has-img" href={p.url}>
          {p.img && <figure class="vimg vimg-card"><img src={p.img.image.replace('/news/', '/news/card/')} alt="" loading="lazy" width="800" height="450" /></figure>}
          <p class="small muted" style="margin:0 0 .3rem">{fmtDate(p.date)}{p.tag && ` · ${p.tag}`}</p>
          <h3>{p.title}</h3>
          <p>{p.summary}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
