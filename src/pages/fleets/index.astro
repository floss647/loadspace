---
import Base from '../../layouts/Base.astro';
import IMAGES from '../../data/images.json';
import PHOTOS from '../../data/photos.json';
import { ICONS, credit } from '../../data/guides.js';

const hero = PHOTOS['royal-mail-electric-van'];
const vcard = (slug) => IMAGES[slug]?.file.replace('/vehicles/', '/vehicles/card/');

const plan = [
  { href: '/guides/fleet-electrification-plan/', title: 'Step-by-step plan', text: 'From telematics data to a pilot to full rollout.' },
  { href: '/tools/fleet-cost/', title: 'Fleet switch calculator', text: 'Yearly savings and payback across your fleet.' },
  { href: '/guides/depot-charging/', title: 'Depot charging', text: 'Power, grid connections, charger choice and smart charging.' },
  { href: '/guides/grants-and-tax/', title: 'Grants and tax', text: 'Van and truck grants, van benefit tax, capital allowances.' },
];
const vehicles = [
  { href: '/vans/', title: 'Electric vans', text: 'Every model by size, including rebadged twins.', slug: 'volkswagen-e-crafter' },
  { href: '/trucks/', title: 'Electric trucks', text: '7.5 to 44 tonnes.', slug: 'volvo-fm-electric' },
  { href: '/reliability/', title: 'Reliability data', text: 'MOT failure rates by model from DVSA records.', slug: 'renault-master' },
  { href: '/guides/are-electric-trucks-ready/', title: 'Are electric trucks ready?', text: 'Where they work today and where they don’t yet.', slug: 'fuso-ecanter' },
];
const fund = [
  { href: '/tools/lease-or-buy/', title: 'Lease, buy new or buy used?', text: 'Compare all three over the time you’ll keep the vehicles.', icon: ICONS.list },
  { href: '/deals/', title: 'Lease deals', text: 'Ranked by true monthly cost.', icon: ICONS.money },
  { href: '/used-electric-vans/', title: 'Used electric vans', text: 'A cheaper way to add electric vans to a fleet.', icon: ICONS.search },
];
// One credit line for the tile photos, grouped by licence.
const tileCredits = Object.entries(
  vehicles.map((v) => IMAGES[v.slug]).filter(Boolean).reduce((acc, img) => {
    (acc[img.licence] ||= []).push(img.author);
    return acc;
  }, {})
).map(([licence, authors]) => `${[...new Set(authors)].join(', ')}, Wikimedia Commons, ${licence}`).join('; ');
---
<Base title="Electric vans and trucks for fleets" description="Plans, calculators and guides for fleet managers switching vans and trucks to electric: total cost, depot charging, grants and driver policies.">
  <section class="hero hero-split">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">For fleet managers</p>
        <h1>Going electric: for fleets</h1>
        <p>Whether you run five vans or five hundred trucks, the questions are the same: which vehicles can switch now, what will it really cost, and can your depot power them?</p>
        <div class="btn-row">
          <a class="btn" href="/fleets/enquiry/">Send a fleet enquiry</a>
          <a class="btn secondary" href="/tools/fleet-cost/">Fleet switch calculator</a>
        </div>
      </div>
      {hero && (
        <figure class="hero-photo">
          <img src={hero.file} alt="A Royal Mail electric van parked on a UK street" width="1280" height="854" />
          <figcaption>{credit(hero)}</figcaption>
        </figure>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="plan">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Step by step</p><h2 id="plan">Plan</h2></div>
        <a class="more" href="/guides/fleet-electrification-plan/">The full plan →</a>
      </div>
      <ol class="audience steps-4">
        {plan.map((p, i) => (
          <li>
            <a class="audience-card" href={p.href}>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <span class="arrow" aria-hidden="true">Read more →</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section tint" aria-labelledby="choose">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Vans and trucks</p><h2 id="choose">Choose vehicles</h2></div>
        <a class="more" href="/compare/">Compare vans →</a>
      </div>
      <div class="size-tiles four">
        {vehicles.map((v) => (
          <a class="size-tile" href={v.href}>
            {vcard(v.slug) && <img src={vcard(v.slug)} alt="" loading="lazy" width="800" height="450" />}
            <span class="size-label"><strong>{v.title}</strong>{v.text}</span>
          </a>
        ))}
      </div>
      {tileCredits && <p class="photo-credits">Photos: {tileCredits}.</p>}
    </div>
  </section>

  <section class="section" aria-labelledby="fund">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Paying for it</p><h2 id="fund">Fund</h2></div>
      </div>
      <div class="tool-grid">
        {fund.map((t) => (
          <a class="tool" href={t.href}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.icon} /></svg>
            <span><strong>{t.title}</strong>{t.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section flush-top">
    <div class="wrap">
      <div class="cta-pair">
        <a class="cta-panel amber" href="/fleets/enquiry/">
          <p class="eyebrow">Fleets</p>
          <h3>Planning to electrify a fleet?</h3>
          <p>Tell us about your vans and trucks and get help with costs, charging and funding.</p>
          <span class="arrow">Send a fleet enquiry →</span>
        </a>
        <a class="cta-panel dark" href="/get-charger-quotes/">
          <p class="eyebrow">Charging</p>
          <h3>Need depot chargers?</h3>
          <p>Get quotes for a home charger or depot charging from vetted installers. Free, no obligation.</p>
          <span class="arrow">Get charger quotes →</span>
        </a>
      </div>

      <div class="invite">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v10H9l-5 4V6z" /></svg>
        <div>
          <p class="eyebrow">Coming soon</p>
          <p>Fleet case studies, real-world range by duty cycle, and interviews with fleet managers who’ve made the switch. Run a fleet and want to share your experience? We’d like to hear from you.</p>
          <a class="invite-link" href="/fleets/enquiry/">Tell us about your fleet →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
