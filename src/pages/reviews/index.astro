---
import Base from '../../layouts/Base.astro';
import VehicleImage from '../../components/VehicleImage.astro';
import { REVIEWS } from '../../lib/reviews.js';
---
<Base title="Electric van reviews" description="What the UK's van testers say about each electric van, summarised in plain English, plus our own score from the published specs.">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Reviews</p>
      <h1>Electric van reviews</h1>
      <p class="lede">We read the published UK road tests so you don't have to, and sum up who thinks what. Each van also gets a Loadspace data score worked out from its published specs, so you can compare them fairly.</p>
    </div>
  </header>
  <div class="wrap">
    <div class="grid review-list">
      {REVIEWS.map((r) => (
        <a class="card has-img" href={r.url}>
          <VehicleImage slug={r.van} name={r.vanName} size="card" />
          <h3>{r.score.overall != null && <span class="score">{r.score.overall.toFixed(1)}</span>}{r.vanName}</h3>
          <p>{r.summary}</p>
        </a>
      ))}
    </div>
    <p class="small muted" style="margin-top:1.5rem">These are roundups of other people's road tests, not our own. <a href="/reviews/how-we-score/">How we score</a>.</p>
  </div>
</Base>
