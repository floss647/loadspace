---
import Base from '../../layouts/Base.astro';
import { SIZES, VANS, TWINS } from '../../data/vans.js';
---
<Base title="Every electric van on sale in the UK" description="Every electric van and pickup on sale in the UK, by size, plus the diesel-only models and their electric alternatives.">
  <div class="wrap">
    <h1>Every electric van on sale in the UK</h1>
    <p class="lede">{VANS.filter((v) => v.electric).length} of the {VANS.length} vans and pickups on sale now come in an electric version. Electric models are listed first in each size; models without one show their nearest electric alternatives. Many are the same van with a different badge, and we mark those.</p>

    <div class="filters" role="group" aria-label="Filter">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="ev" aria-pressed="false">Has an electric version</button>
    </div>

    {Object.entries(SIZES).map(([key, s]) => (
      <section id={key}>
        <h2>{s.label}</h2>
        <p class="muted">{s.blurb}</p>
        <div class="grid">
          {VANS.filter((v) => v.size === key).sort((a, b) => b.electric - a.electric).map((v) => (
            <a class="card van-card" href={`/vans/${v.slug}/`} data-ev={v.electric ? 'y' : 'n'}>
              <h3>{v.name}</h3>
              <p>
                {v.topSeller && <span class="tag top">Top seller</span>}
                {v.electric ? <span class="tag ev">Electric</span> : <span class="tag">No electric version</span>}
                {v.twin && <span class="tag">Twin: {TWINS[v.twin].name}</span>}
              </p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  <script>
    const buttons = document.querySelectorAll('[data-filter]');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        const evOnly = b.dataset.filter === 'ev';
        document.querySelectorAll('.van-card').forEach((c) => {
          c.style.display = evOnly && c.dataset.ev !== 'y' ? 'none' : '';
        });
      })
    );
  </script>
</Base>
