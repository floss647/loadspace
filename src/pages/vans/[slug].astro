---
import Base from '../../layouts/Base.astro';
import Reliability from '../../components/Reliability.astro';
import Cta from '../../components/Cta.astro';
import VehicleImage from '../../components/VehicleImage.astro';
import { SIZES, EV_VANS, TWINS, twinsOf } from '../../data/vans.js';
import { DEALS, DEALS_ARE_SAMPLE, trueCost } from '../../data/deals.js';

export function getStaticPaths() {
  return EV_VANS.map((van) => ({ params: { slug: van.slug }, props: { van } }));
}

const { van } = Astro.props;
const size = SIZES[van.size];
const kind = van.size === 'pickup' ? 'pickup' : 'van';
const electricOnly = van.name === van.baseName; // sold only as an electric model
const evTwins = twinsOf(van).filter((t) => t.electric);
const twinInfo = van.twin ? TWINS[van.twin] : null;
const deals = DEALS.filter((d) => d.van === van.slug && d.fuel === 'Electric')
  .map((d) => ({ ...d, tc: trueCost(d) }))
  .sort((a, b) => a.tc.perMonth - b.tc.perMonth);
const gbp = (n) => '£' + Math.round(n).toLocaleString('en-GB');
const note = van.electricNote.replace(/^Electric only\.\s*/, '').replace(/^Sold as the [^.]+\.\s*/, '');
---
<Base title={`${van.name}: buyer's guide, running costs and charging`} description={`${van.name}: whether it suits your work, running costs, charging, rebadged twins, buying used and lease deals.`}>
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a> › <a href="/vans/">Electric vans</a> › <a href={`/vans/#${van.size}`}>{size.label}</a></div>
    <article class="prose">
      <h1>{van.name}</h1>
      <p>
        <span class="tag">{size.short}</span>
        {van.topSeller && <span class="tag top">Top-selling model</span>}
      </p>
      <VehicleImage slug={van.slug} name={van.name} />
      <p class="lede">{van.intro || `A ${size.short.toLowerCase()} electric ${kind}. ${size.blurb}`}</p>
      {note && <p>{note}</p>}
      {!electricOnly && <p class="small muted">Also sold with diesel or petrol engines as the {van.baseName}.</p>}

      <div class="notice"><strong>Full road test coming.</strong> We're adding loaded-up driving impressions, real-world range in summer and winter, and owner interviews. This page already covers the buying basics.</div>

      <h2>Will it suit your work?</h2>
      <p>The {van.name} is likely to suit you if you do <strong>under about 100 miles on a normal day</strong>, can <strong>charge off-street overnight</strong>, and work mostly in or around towns. It's a harder sell for long motorway days, heavy towing, or if you'd rely on public rapid chargers.</p>
      <div class="btn-row">
        <a class="btn" href="/tools/electric-vs-diesel/">Will it save me money?</a>
        <a class="btn secondary" href="/guides/charging-an-electric-van/">How charging works</a>
      </div>

      <Cta kind="charger" />

      {evTwins.length > 0 && (
        <>
          <h2>Same van, other badges</h2>
          <p>{twinInfo.note} So you can shop the {van.name} against its twins on price, warranty, dealer network and lease offers, rather than on the {kind} itself.</p>
          <ul>
            {evTwins.map((t) => <li><a href={`/vans/${t.slug}/`}>{t.name}</a></li>)}
          </ul>
          <p class="small"><a href="/guides/rebadged-vans/">How to use rebadged twins to pay less →</a></p>
        </>
      )}

      <h2>Buying used: what to check</h2>
      <ul>
        <li><strong>Battery health.</strong> Ask for a battery health (State of Health) certificate and check what's left of the battery warranty.</li>
        <li><strong>Real range for your work.</strong> Expect much less than the official figure with a full load in winter.</li>
        <li><strong>Charging.</strong> Check the rapid-charging connector and onboard charger speed, and that the charging cable comes with the {kind}.</li>
        <li><strong>MOT and mileage history.</strong> <a href="/tools/van-check/">Check it free by registration</a>.</li>
        <li><strong>The load area.</strong> Damaged floors, bulkheads and side panels show how hard it worked.</li>
        <li><strong>Payload.</strong> Batteries are heavy, and racking or fit-outs reduce payload further. Check the plated weight against what you carry.</li>
      </ul>
      <p class="small"><a href="/guides/used-electric-van-buying-guide/">Full used electric van checklist →</a></p>

      {!electricOnly && <Reliability slug={van.slug} name={van.baseName} />}

      <div class="card" style="margin-top:2rem"><strong>Running several of these?</strong> See our <a href="/fleets/">fleet guides</a>, the <a href="/tools/fleet-cost/">fleet switch calculator</a>, or <a href="/fleets/enquiry/">send us a fleet enquiry</a>.</div>

      <h2>Lease deals</h2>
      {DEALS_ARE_SAMPLE && <p class="notice small"><strong>Sample prices.</strong> These figures are placeholders while we connect live broker feeds. They are not real offers.</p>}
      {deals.length ? (
        <div class="table-wrap">
          <table>
            <thead><tr><th>Version</th><th class="num">Advertised</th><th class="num">True cost / month</th><th>Terms</th></tr></thead>
            <tbody>
              {deals.map((d) => (
                <tr>
                  <td>{d.version}<br /><span class="muted small">{d.broker}</span></td>
                  <td class="num">{gbp(d.monthly)}</td>
                  <td class="num"><strong>{gbp(d.tc.perMonth)}</strong></td>
                  <td class="small">{d.upfrontMonths} upfront, {d.term} months, {d.miles.toLocaleString('en-GB')} miles/yr</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p>No deals listed yet. <a href="/deals/">See all electric van deals</a>.</p>
      )}
 <Cta kind="lease" van={van} />
      <p class="small muted">Business contract hire, excluding VAT. "True cost" spreads the upfront payment and fees across the whole term. <a href="/tools/lease-true-cost/">How we work it out</a>.</p>
    </article>
  </div>
</Base>
