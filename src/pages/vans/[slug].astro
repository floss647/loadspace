---
import Base from '../../layouts/Base.astro';
import Reliability from '../../components/Reliability.astro';
import Cta from '../../components/Cta.astro';
import VehicleImage from '../../components/VehicleImage.astro';
import { SIZES, EV_VANS, TWINS, twinsOf } from '../../data/vans.js';
import { DEALS, DEALS_ARE_SAMPLE, trueCost } from '../../data/deals.js';
import { reviewFor } from '../../lib/reviews.js';

export function getStaticPaths() {
  return EV_VANS.map((van) => ({ params: { slug: van.slug }, props: { van } }));
}

const { van } = Astro.props;
const size = SIZES[van.size];
const kind = van.size === 'pickup' ? 'pickup' : 'van';
const electricOnly = van.name === van.baseName; // sold only as an electric model
const evTwins = twinsOf(van).filter((t) => t.electric);
const twinInfo = van.twin ? TWINS[van.twin] : null;
const deals = DEALS.filter((d) => d.van === van.slug && d.fuel === 'Electric')
  .map((d) => ({ ...d, tc: trueCost(d) }))
  .sort((a, b) => a.tc.perMonth - b.tc.perMonth);
const gbp = (n) => '£' + Math.round(n).toLocaleString('en-GB');
const review = reviewFor(van.slug);
// Key figures from our fact-checked review, where we have one.
const short = (v) => String(v ?? '').replace(/\s*\(.*$/, '');
const conf = (v) => v && !/^not confirmed/i.test(String(v));
const figs = review ? [
  ['Official range', review.specs?.range],
  ['Rapid charging', review.specs?.charging],
  ['Max payload', review.specs?.payload],
  ['Price from', review.price?.confirmed ? review.price.value : null],
].filter(([, v]) => conf(v)).map(([k, v]) => [k, short(v)]) : [];
const checks = [
  ['Battery health', "Ask for a battery health (State of Health) certificate and check what's left of the battery warranty."],
  ['Real range for your work', 'Expect much less than the official figure with a full load in winter.'],
  ['Charging', `Check the rapid-charging connector and onboard charger speed, and that the charging cable comes with the ${kind}.`],
  ['MOT and mileage history', null],
  ['The load area', 'Damaged floors, bulkheads and side panels show how hard it worked.'],
  ['Payload', 'Batteries are heavy, and racking or fit-outs reduce payload further. Check the plated weight against what you carry.'],
];
const note = van.electricNote.replace(/^Electric only\.\s*/, '').replace(/^Sold as the [^.]+\.\s*/, '');
---
<Base title={`${van.name}: buyer's guide, running costs and charging`} description={`${van.name}: whether it suits your work, running costs, charging, rebadged twins, buying used and lease deals.`}>
  <section class="review-hero van-hero">
    <div class="wrap review-hero-grid">
      <div class="review-hero-copy">
        <div class="crumbs"><a href="/">Home</a> › <a href="/vans/">Electric vans</a> › <a href={`/vans/#${van.size}`}>{size.label}</a></div>
        <p class="eyebrow">{size.label.replace(/s$/, '')}{van.topSeller ? ' · Top-selling model' : ''}{electricOnly ? ' · Electric only' : ''}</p>
        <h1>{van.name}</h1>
        <p class="review-summary">{van.intro || `A ${size.short.toLowerCase()} electric ${kind}. ${size.blurb}`}</p>
        {figs.length > 0 && (
          <ul class="van-figs">
            {figs.map(([k, v]) => <li><strong>{v}</strong><span>{k}</span></li>)}
          </ul>
        )}
        <div class="btn-row">
          {review && <a class="btn" href={review.url}>Read our review{review.score.overall != null ? ` · ${review.score.overall.toFixed(1)}/5` : ''}</a>}
          <a class={review ? 'btn ghost-light' : 'btn'} href="/tools/electric-vs-diesel/">Will it save me money?</a>
        </div>
      </div>
      <div class="review-photo"><VehicleImage slug={van.slug} name={van.name} /></div>
    </div>
  </section>

  <div class="wrap review-grid">
    <article class="prose review-body">
      {(note || !electricOnly) && (
        <div class="verdict-callout">
          <p class="eyebrow">At a glance</p>
          <p>{note}{note && !electricOnly ? ' ' : ''}{!electricOnly && `Also sold with diesel or petrol engines as the ${van.baseName}.`}</p>
        </div>
      )}
      {!review && <div class="notice"><strong>Full review coming.</strong> This page already covers the buying basics.</div>}

      <h2>Will it suit your work?</h2>
      <div class="suit-grid">
        <div class="gb good"><h3>A good fit if you</h3><ul><li>Do under about 100 miles on a normal day</li><li>Can charge off-street overnight</li><li>Work mostly in or around towns</li></ul></div>
        <div class="gb bad"><h3>A harder sell if you</h3><ul><li>Do long motorway days</li><li>Tow heavy loads</li><li>Would rely on public rapid chargers</li></ul></div>
      </div>
      <p class="small"><a href="/guides/charging-an-electric-van/">How charging works →</a></p>

      {evTwins.length > 0 && (
        <>
          <h2>Same van, other badges</h2>
          <p>{twinInfo.note} So you can shop the {van.name} against its twins on price, warranty, dealer network and lease offers, rather than on the {kind} itself.</p>
          <div class="twin-chips">
            {evTwins.map((t) => <a href={`/vans/${t.slug}/`}>{t.name} →</a>)}
          </div>
          <p class="small"><a href="/guides/rebadged-vans/">How to use rebadged twins to pay less →</a></p>
        </>
      )}

      <h2>Buying used: what to check</h2>
      <ol class="check-grid">
        {checks.map(([t, d]) => (
          <li><strong>{t}</strong>{d ? <span>{d}</span> : <span><a href="/tools/van-check/">Check it free by registration</a>.</span>}</li>
        ))}
      </ol>
      <p class="small"><a href="/guides/used-electric-van-buying-guide/">Full used electric van checklist →</a></p>

      {!electricOnly && <Reliability slug={van.slug} name={van.baseName} />}

      <h2>Lease deals</h2>
      {DEALS_ARE_SAMPLE && <p class="notice small"><strong>Sample prices.</strong> These figures are placeholders while we connect live broker feeds. They are not real offers.</p>}
      {deals.length ? (
        <div class="table-wrap">
          <table>
            <thead><tr><th>Version</th><th class="num">Advertised</th><th class="num">True cost / month</th><th>Terms</th></tr></thead>
            <tbody>
              {deals.map((d) => (
                <tr>
                  <td>{d.version}<br /><span class="muted small">{d.broker}</span></td>
                  <td class="num">{gbp(d.monthly)}</td>
                  <td class="num"><strong>{gbp(d.tc.perMonth)}</strong></td>
                  <td class="small">{d.upfrontMonths} upfront, {d.term} months, {d.miles.toLocaleString('en-GB')} miles/yr</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p>No deals listed yet. <a href="/deals/">See all electric van deals</a>.</p>
      )}
      <Cta kind="lease" van={van} />
      <p class="small muted">Business contract hire, excluding VAT. "True cost" spreads the upfront payment and fees across the whole term. <a href="/tools/lease-true-cost/">How we work it out</a>.</p>
    </article>

    <aside class="review-aside">
      {review && (
        <a class="score-card van-review-card" href={review.url}>
          <div class="score-card-head">
            {review.score.overall != null ? <span class="medal-score">{review.score.overall.toFixed(1)}<small>/5</small></span> : <span class="medal-score">n/a</span>}
            <span><strong>Our review</strong><br /><span class="small muted">{review.score.overall != null ? 'Loadspace data score' : 'Not scored yet'}</span></span>
          </div>
          <p class="small">{review.summary}</p>
          <span class="arrow">Read the review →</span>
        </a>
      )}
      <Cta kind="charger" />
      <div class="score-card aside-fleet">
        <strong>Running several of these?</strong>
        <p class="small">See our <a href="/fleets/">fleet guides</a>, the <a href="/tools/fleet-cost/">fleet switch calculator</a>, or <a href="/fleets/enquiry/">send us a fleet enquiry</a>.</p>
      </div>
    </aside>
  </div>
</Base>
