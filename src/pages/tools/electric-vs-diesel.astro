---
import Tool from '../../layouts/Tool.astro';
import { frontmatter as tax } from '../../data/rules/van-tax-2026-27.md';
const r = tax.rates;
const gbp = (n: number) => '£' + n.toLocaleString('en-GB');
---
<Tool metaTitle="Electric vs diesel van running cost calculator" title="Electric vs diesel: what will it cost you?" description="Compare the yearly fuel, charging and road tax cost of an electric van against diesel, plus the driver's company van tax, based on your miles and where you charge." lede="Put in your own numbers. The defaults are rough examples for a medium van, not quotes." icon="M4 18h16M7 14l3-3 3 3 5-6">
  <form id="calc" onsubmit="return false" slot="inputs" data-rates={JSON.stringify(r)}>
    <fieldset class="tool-group">
      <legend><span class="step">1</span>Your driving</legend>
      <div class="form">
        <label>Miles per year<input type="number" id="miles" value="15000" min="0" step="500" /></label>
        <label>London Congestion Charge days per year<input type="number" id="ccDays" value="0" min="0" step="1" /></label>
      </div>
    </fieldset>
    <fieldset class="tool-group">
      <legend><span class="step">2</span>Diesel</legend>
      <div class="form">
        <label>Diesel price (pence per litre)<input type="number" id="dieselPrice" value="142" min="0" step="1" /></label>
        <label>Diesel economy (miles per gallon)<input type="number" id="mpg" value="35" min="1" step="1" /></label>
      </div>
    </fieldset>
    <fieldset class="tool-group">
      <legend><span class="step">3</span>Electric</legend>
      <div class="form">
        <label>Electric efficiency (miles per kWh)<input type="number" id="mpk" value="2.5" min="0.5" step="0.1" /></label>
        <label>Home or depot electricity (pence per kWh)<input type="number" id="homePrice" value="9" min="0" step="0.5" /></label>
        <label>Public rapid charging (pence per kWh)<input type="number" id="publicPrice" value="79" min="0" step="1" /></label>
        <label>Share of charging done on public chargers (%)<input type="number" id="publicShare" value="10" min="0" max="100" step="5" /></label>
      </div>
    </fieldset>
    <fieldset class="tool-group">
      <legend><span class="step">4</span>Tax</legend>
      <div class="form">
        <label>Does the driver take the van home?
          <select id="home">
            <option value="no" selected>No</option>
            <option value="commute">Yes, commuting only</option>
            <option value="private">Yes, with other private use</option>
          </select>
        </label>
        <label>Driver's income tax rate
          <select id="taxRate">
            <option value={r.incomeTax.basic} selected>{r.incomeTax.basic}% (basic rate)</option>
            <option value={r.incomeTax.higher}>{r.incomeTax.higher}% (higher rate)</option>
            <option value={r.incomeTax.additional}>{r.incomeTax.additional}% (additional rate)</option>
          </select>
        </label>
        <label>Does the business pay for private fuel?
          <select id="fuel">
            <option value="0" selected>No</option>
            <option value="1">Yes</option>
          </select>
        </label>
      </div>
      <p class="tool-hint small muted">Uses {r.taxYear} rates. Company van tax only applies to an employee driving an employer's van. <a href="/guides/grants-and-tax/">How van tax and grants work</a></p>
    </fieldset>
  </form>

  <div slot="results">
    <h2>Your yearly running cost</h2>
    <div class="grid">
      <div class="highlight"><div class="muted small">Difference</div><div class="big" id="saving">–</div><div class="muted small" id="savingNote"></div></div>
      <div><div class="muted small">Diesel per year</div><div class="big" id="dieselCost">–</div><div class="muted small" id="dieselPpm"></div></div>
      <div><div class="muted small">Electric per year</div><div class="big" id="evCost">–</div><div class="muted small" id="evPpm"></div></div>
    </div>
    <div class="tool-bars" aria-hidden="true">
      <div class="tool-bar"><span>Diesel</span><span class="track"><span class="fill diesel" id="barDiesel"></span></span></div>
      <div class="tool-bar"><span>Electric</span><span class="track"><span class="fill ev" id="barEv"></span></span></div>
    </div>
    <p class="small muted" style="margin:.8rem 0 0">Road tax: {gbp(r.ved.van)} for both, included in the yearly costs above.</p>

    <div class="tool-sub">
      <h2>Driver's company van tax</h2>
      <p class="small muted" style="margin:0 0 .8rem">Paid by the driver, not the business, so it's kept out of the running costs above.</p>
      <div class="grid">
        <div><div class="muted small">Diesel van, per year</div><div class="big" id="bikDiesel">–</div><div class="muted small" id="bikDieselNote"></div></div>
        <div><div class="muted small">Electric van, per year</div><div class="big" id="bikEv">–</div><div class="muted small" id="bikEvNote"></div></div>
      </div>
    </div>
    <p class="small muted tool-rates">{r.taxYear} rates. <a href="/guides/grants-and-tax/">How van tax and grants work</a></p>
  </div>

  <h2>How this works</h2>
      <ul>
        <li><strong>Diesel:</strong> miles ÷ mpg × 4.546 litres per gallon × price per litre.</li>
        <li><strong>Electric:</strong> miles ÷ miles per kWh, split between home and public charging prices.</li>
        <li><strong>Congestion Charge:</strong> since January 2026, electric vans registered for Auto Pay pay 50% (£9 a day) against £18 for diesel.</li>
        <li><strong>Road tax:</strong> in {r.taxYear}, a diesel, petrol or electric van up to {r.ved.maxKg.toLocaleString('en-GB')}kg pays {gbp(r.ved.van)} a year. Electric vans lost their exemption in April 2025, so road tax no longer makes a difference between the two.</li>
        <li><strong>Driver's company van tax:</strong> if an employee can use a company diesel van privately, they pay income tax on a van benefit charge of {gbp(r.vanBenefit.diesel)} a year, at their own rate. If the business also pays for private fuel, a fuel benefit charge of {gbp(r.vanFuelBenefit.diesel)} is added. For an electric (zero-emission) van, both charges are {gbp(r.vanBenefit.zeroEmission)}.</li>
        <li><strong>Commuting only:</strong> there's no charge for either van if the driver only uses it to get to and from work and the terms of use forbid other private use. Insignificant private use, such as a small detour for a newspaper on the way to work, doesn't count.</li>
      </ul>
      <p>The driver's tax uses the {r.incomeTax.basic}%, {r.incomeTax.higher}% and {r.incomeTax.additional}% rates for England, Wales and Northern Ireland; Scotland's bands are different. The employer also pays National Insurance on the van benefit, which isn't shown here. Tax rules have conditions this calculator can't check, so check with your accountant. <a href="/guides/grants-and-tax/">Read our grants and tax guide</a>.</p>
      <p><strong>Not included:</strong> purchase or lease price, servicing (usually lower for electric), insurance, a home charger, or clean air zone charges for older diesels. Electric efficiency drops in cold weather and with heavy loads, so use a lower figure if that's your work.</p>
      <p><a href="/guides/used-electric-van-buying-guide/">Thinking about a used electric van? Read the checks first →</a></p>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const R = JSON.parse(($('calc') as HTMLElement).dataset.rates || '{}');
    const gbp = (n: number) => (n < 0 ? '-' : '') + '£' + Math.abs(Math.round(n)).toLocaleString('en-GB');
    function calc() {
      const miles = +$('miles').value || 0;
      const litres = (miles / Math.max(+$('mpg').value, 1)) * 4.546;
      const cc = +$('ccDays').value || 0;
      const ved = R.ved.van;
      const diesel = (litres * (+$('dieselPrice').value || 0)) / 100 + cc * 18 + ved;
      const kwh = miles / Math.max(+$('mpk').value, 0.1);
      const share = Math.min(Math.max(+$('publicShare').value || 0, 0), 100) / 100;
      const ev = (kwh * ((1 - share) * (+$('homePrice').value || 0) + share * (+$('publicPrice').value || 0))) / 100 + cc * 9 + ved;
      $('dieselCost').textContent = gbp(diesel);
      $('evCost').textContent = gbp(ev);
      const ppm = (x: number) => (miles ? ((x * 100) / miles).toFixed(1) + 'p per mile' : '');
      $('dieselPpm').textContent = ppm(diesel);
      $('evPpm').textContent = ppm(ev);
      const s = diesel - ev;
      $('saving').textContent = gbp(Math.abs(s));
      $('savingNote').textContent = s >= 0 ? 'cheaper with electric' : 'cheaper with diesel';
      const max = Math.max(diesel, ev, 1);
      $('barDiesel').style.width = (diesel / max) * 100 + '%';
      $('barEv').style.width = (ev / max) * 100 + '%';

      // Driver's company van tax (personal, not a business cost).
      const home = $('home').value;
      const rate = +$('taxRate').value / 100;
      const fuel = $('fuel').value === '1';
      if (home === 'private') {
        const charge = R.vanBenefit.diesel + (fuel ? R.vanFuelBenefit.diesel : 0);
        $('bikDiesel').textContent = gbp(charge * rate);
        $('bikDieselNote').textContent = `${gbp(R.vanBenefit.diesel)} van benefit${fuel ? ` + ${gbp(R.vanFuelBenefit.diesel)} fuel benefit` : ''} × ${+$('taxRate').value}%`;
        $('bikEv').textContent = gbp(R.vanBenefit.zeroEmission);
        $('bikEvNote').textContent = 'No van or fuel benefit charge on a zero-emission van';
      } else {
        $('bikDiesel').textContent = gbp(0);
        $('bikEv').textContent = gbp(0);
        const note = home === 'commute' ? 'Commuting only: no charge, as long as the terms of use forbid other private use' : 'No private use, so no charge';
        $('bikDieselNote').textContent = note;
        $('bikEvNote').textContent = note;
      }
    }
    document.querySelectorAll('#calc input, #calc select').forEach((i) => i.addEventListener('input', calc));
    calc();
  </script>
</Tool>
