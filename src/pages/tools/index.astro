---
import Base from '../../layouts/Base.astro';
const tools = [
  ['/tools/electric-vs-diesel/', 'Electric vs diesel cost', 'Yearly running cost of an electric van against diesel, based on how and where you charge.', 'M4 18h16M7 14l3-3 3 3 5-6', 'Most used'],
  ['/tools/lease-or-buy/', 'Lease, buy new or buy used?', 'Compare all three over the years you keep the van, with or without VAT.', 'M5 7h14M5 12h14M5 17h9'],
  ['/tools/lease-true-cost/', 'Lease true-cost calculator', 'Turn any lease quote into a real monthly cost so you can compare deals fairly.', 'M12 4v16M8 8h6a3 3 0 0 1 0 6H9'],
  ['/tools/fleet-cost/', 'Fleet switch calculator', 'Yearly savings and payback when you switch some or all of a fleet to electric.', 'M4 17V9m5 8V5m5 12v-6m5 6V8'],
  ['/tools/van-check/', 'Free van check', 'MOT history, mileage record, repeat advisories, tax and recalls for any UK van.', 'M10 17a7 7 0 1 1 5-2l4 4'],
  ['/reliability/', 'Most reliable vans', 'MOT failure rates by model and age from official DVSA data.', 'M5 12l4 4 10-10'],
];
---
<Base title="Electric van and fleet tools" description="Free calculators and checks for electric van and truck buyers and fleets: running costs, fleet savings, lease vs buy, van checks and reliability data.">
  <section class="tool-hero">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> › Tools</div>
      <p class="eyebrow">Free tools</p>
      <h1>Check the numbers before you sign anything</h1>
      <p class="review-summary">Six free calculators and checks for van buyers and fleets. Put in your own figures and see the answer straight away. No sign-up.</p>
    </div>
  </section>
  <div class="wrap">
    <div class="tool-cards">
      {tools.map(([href, t, d, icon, badge]) => (
        <a class="tool-card" href={href}>
          <span class="tool-hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icon} /></svg></span>
          {badge && <span class="pill">{badge}</span>}
          <h2>{t}</h2>
          <p>{d}</p>
          <span class="arrow">Open the tool →</span>
        </a>
      ))}
    </div>
  </div>
</Base>
