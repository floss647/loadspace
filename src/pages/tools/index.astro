---
import Base from '../../layouts/Base.astro';
import { itemList } from '../../lib/seo.js';
import { TOOLS as tools } from '../../data/tools.js';
const ld = itemList(Astro.site, 'Electric van and fleet tools', tools.map(([href, name]) => [name, href]));
---
<Base title="Electric van and fleet tools" description="Free calculators and checks for electric van and truck buyers and fleets: running costs, fleet savings, lease vs buy, van checks and reliability data." jsonLd={ld} crumbs={[['Home', '/']]} crumbName="Tools">
  <section class="tool-hero">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a> › Tools</div>
      <p class="eyebrow">Free tools</p>
      <h1>Check the numbers before you sign anything</h1>
      <p class="review-summary">Six free calculators and checks for van buyers and fleets. Put in your own figures and see the answer straight away. No sign-up.</p>
    </div>
  </section>
  <div class="wrap">
    <div class="tool-cards">
      {tools.map(([href, t, d, icon, badge]) => (
        <a class="tool-card" href={href}>
          <span class="tool-hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icon} /></svg></span>
          {badge && <span class="pill">{badge}</span>}
          <h2>{t}</h2>
          <p>{d}</p>
          <span class="arrow">Open the tool →</span>
        </a>
      ))}
    </div>
  </div>
</Base>
