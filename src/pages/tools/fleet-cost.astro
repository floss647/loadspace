---
import Tool from '../../layouts/Tool.astro';
---
<Tool metaTitle="Fleet electric switch calculator" title="Fleet switch calculator" description="Estimate what switching a fleet of vans to electric saves each year, and how long it takes to pay back." lede="What switching some or all of your vans to electric could save each year, and how long the extra upfront cost takes to pay back. Defaults are rough examples, not quotes: put in your own figures." icon="M4 17V9m5 8V5m5 12v-6m5 6V8" crumb={['/fleets/', 'Fleets']}>
  <form id="calc" onsubmit="return false" slot="inputs">
    <fieldset class="tool-group">
      <legend><span class="step">1</span>Your fleet</legend>
      <div class="form">
        <label>Vans switching to electric<input type="number" id="n" value="10" min="1" step="1" /></label>
        <label>Miles per van per year<input type="number" id="miles" value="15000" min="0" step="500" /></label>
        <label>Congestion Charge days per van per year<input type="number" id="cc" value="0" min="0" step="1" /></label>
        <label>Drivers who take vans home<input type="number" id="home" value="0" min="0" step="1" /></label>
        <label>Van benefit charge per diesel van (£, taxable)<input type="number" id="vb" value="4000" min="0" step="10" /></label>
      </div>
    </fieldset>
    <fieldset class="tool-group">
      <legend><span class="step">2</span>Diesel vans</legend>
      <div class="form">
        <label>Diesel price (pence per litre, excl. VAT)<input type="number" id="dp" value="118" min="0" step="1" /></label>
        <label>Diesel economy (mpg)<input type="number" id="mpg" value="35" min="1" step="1" /></label>
        <label>Servicing per diesel van per year (£)<input type="number" id="sd" value="700" min="0" step="50" /></label>
      </div>
    </fieldset>
    <fieldset class="tool-group">
      <legend><span class="step">3</span>Electric vans</legend>
      <div class="form">
        <label>Electric efficiency (miles per kWh)<input type="number" id="mpk" value="2.5" min="0.5" step="0.1" /></label>
        <label>Depot or home electricity (pence per kWh)<input type="number" id="ep" value="18" min="0" step="0.5" /></label>
        <label>Public charging (pence per kWh)<input type="number" id="pp" value="66" min="0" step="1" /></label>
        <label>Share of charging on public chargers (%)<input type="number" id="ps" value="10" min="0" max="100" step="5" /></label>
        <label>Servicing per electric van per year (£)<input type="number" id="se" value="450" min="0" step="50" /></label>
        <label>Extra upfront cost per electric van after grant (£)<input type="number" id="up" value="6000" min="0" step="250" /></label>
      </div>
    </fieldset>
  </form>

  <div slot="results">
    <h2>Your fleet saving</h2>
      <div class="grid">
        <div><div class="muted small">Fleet saving per year</div><div class="big" id="save">–</div><div class="muted small" id="perVan"></div></div>
        <div><div class="muted small">Payback on extra upfront cost</div><div class="big" id="payback">–</div><div class="muted small" id="upTotal"></div></div>
        <div><div class="muted small">Energy cost per mile</div><div class="big" id="ppm">–</div><div class="muted small">electric vs diesel</div></div>
      </div>
      <p class="small muted" id="bik" style="margin-top:1rem"></p>
  </div>


      <h2>How it works</h2>
      <ul>
        <li><strong>Diesel fuel:</strong> miles ÷ mpg × 4.546 litres per gallon × price per litre.</li>
        <li><strong>Electric energy:</strong> miles ÷ miles per kWh, split between depot/home and public prices.</li>
        <li><strong>Congestion Charge:</strong> £18 a day for diesel, £9 for electric on Auto Pay (from January 2026).</li>
        <li><strong>Extra upfront cost:</strong> the difference in purchase price, or in total lease cost, after any grant. Enter 0 if leasing costs are similar.</li>
        <li><strong>Van benefit:</strong> drivers' tax saving is shown separately, because it's a saving for staff rather than the business.</li>
      </ul>
      <p>Prices here are business figures without VAT. <strong>Not included:</strong> chargers and grid work, insurance, resale values, and downtime. <a href="/guides/fleet-electrification-plan/">Read the fleet plan</a> and <a href="/guides/depot-charging/">depot charging guide</a>.</p>
  <script>
    const $ = (id) => document.getElementById(id);
    const v = (id) => +$(id).value || 0;
    const gbp = (n) => (n < 0 ? '-£' : '£') + Math.abs(Math.round(n)).toLocaleString('en-GB');
    function calc() {
      const n = Math.max(v('n'), 1), miles = v('miles');
      const dieselFuel = (miles / Math.max(v('mpg'), 1)) * 4.546 * v('dp') / 100;
      const share = Math.min(Math.max(v('ps'), 0), 100) / 100;
      const evEnergy = (miles / Math.max(v('mpk'), 0.1)) * ((1 - share) * v('ep') + share * v('pp')) / 100;
      const perVan = (dieselFuel - evEnergy) + (v('sd') - v('se')) + v('cc') * (18 - 9);
      const total = perVan * n;
      $('save').textContent = gbp(total);
      $('perVan').textContent = `${gbp(perVan)} per van`;
      const upTotal = v('up') * n;
      $('upTotal').textContent = `${gbp(upTotal)} extra upfront across the fleet`;
      $('payback').textContent = upTotal === 0 ? 'Immediate' : perVan <= 0 ? 'Doesn’t pay back' : `${(upTotal / total).toFixed(1)} years`;
      $('ppm').textContent = miles ? `${(evEnergy * 100 / miles).toFixed(1)}p vs ${(dieselFuel * 100 / miles).toFixed(1)}p` : '–';
      const home = Math.min(v('home'), n);
      $('bik').textContent = home ? `Drivers who take vans home: ${home} × ${gbp(v('vb'))} of taxable van benefit removed, about ${gbp(home * v('vb') * 0.2)}–${gbp(home * v('vb') * 0.4)} a year in tax saved across those drivers (20–40% taxpayers), plus employer National Insurance saved.` : '';
    }
    document.querySelectorAll('#calc input').forEach((i) => i.addEventListener('input', calc));
    calc();
  </script>
</Tool>
