---
import Base from '../../layouts/Base.astro';
import { fmtDate } from '../../lib/news.js';
import { COLUMNS, COLUMN } from '../../lib/blog.js';
---
<Base title={`${COLUMN.name}: the weekly van column`} description={COLUMN.strap}>
  <div class="wrap">
    <p class="column-badge">Weekly column</p>
    <h1>{COLUMN.name}</h1>
    <p class="lede">{COLUMN.strap} Out every Friday.</p>
    {COLUMNS.length === 0 && <p class="muted">The first column is on its way.</p>}
    <div class="news-list">
      {COLUMNS.map((p) => (
        <a class="card has-img" href={p.url}>
          {p.img && <figure class="vimg vimg-card"><img src={p.img.image.replace('/blog/', '/blog/card/')} alt="" loading="lazy" width="800" height="450" /></figure>}
          <p class="small muted" style="margin:0 0 .3rem">{fmtDate(p.date)}</p>
          <h3>{p.title}</h3>
          <p>{p.summary}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
