---
// Neat spec display for a van page: pick a version, see the key figures as tiles,
// with the full checked tables tucked behind "View full specs".
const { specs } = Astro.props;
const LABELS = {
  range: 'Official range', battery: 'Battery', payload: 'Payload', volume: 'Load volume',
  loadLength: 'Load length', loadHeight: 'Load height', loadWidth: 'Width between wheel arches',
  gross: 'Gross weight', towing: 'Towing (braked)', topSpeed: 'Top speed', rapidTime: 'Rapid charge, 10 to 80%',
  rapid: 'Rapid charging', ac: 'Home and depot charging', warranty: 'Battery warranty', train: 'Gross train weight',
};
// Simple line icons, drawn in currentColor.
const ICONS = {
  range: '<path d="M4 18h16M6 18l3-12h6l3 12M12 6v3m0 3v2"/>',
  battery: '<rect x="3" y="7" width="16" height="10" rx="2"/><path d="M21 11v2M7 10v4m4-4v4"/>',
  payload: '<path d="M6 9h12l2 11H4L6 9z"/><path d="M9 9a3 3 0 0 1 6 0"/>',
  volume: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>',
  loadLength: '<path d="M3 12h18M6 9l-3 3 3 3M18 9l3 3-3 3"/>',
  loadHeight: '<path d="M12 3v18M9 6l3-3 3 3M9 18l3 3 3-3"/>',
  loadWidth: '<path d="M4 6v12M20 6v12M7 12h10M9 10l-2 2 2 2M15 10l2 2-2 2"/>',
  gross: '<path d="M5 20h14l-2-11H7L5 20z"/><circle cx="12" cy="6" r="2"/>',
  towing: '<circle cx="8" cy="16" r="3"/><path d="M11 16h6V8M14 11l3-3 3 3"/>',
  topSpeed: '<path d="M4 16a8 8 0 1 1 16 0"/><path d="M12 16l4-5"/>',
  rapidTime: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2M10 2h4"/>',
  rapid: '<path d="M13 2L5 14h6l-1 8 8-12h-6l1-8z"/>',
  ac: '<path d="M3 11l9-7 9 7v9H3v-9z"/><path d="M13 10l-3 4h3l-1 3"/>',
  warranty: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  train: '<rect x="2" y="9" width="11" height="7" rx="1"/><rect x="15" y="10" width="7" height="6" rx="1"/><path d="M13 13h2"/>',
};
const tile = (k, v) => ({ k, v, label: LABELS[k] || k, icon: ICONS[k] || ICONS.volume });
const versions = specs.versions || [];
const shared = Object.entries(specs.shared || {}).map(([k, v]) => tile(k, v));
const equipment = (specs.equipment || []).filter((t) => t.groups?.length);
const options = (specs.options || []).filter((c) => c.items?.length);
const SHOW = 6;
// "Included as standard" inside each option category: matching items from the checked
// standard equipment lists. Base trim first, then what higher trims add.
const GROUP_FOR = {
  'Safety and driver assistance': ['Safety and driver assistance'],
  'Seats and cab': ['Cab and comfort'],
  'Multimedia': ['Multimedia and connectivity'],
  'Charging': ['Charging and battery'],
  'Load area': ['Load area'],
};
const KEYWORDS = {
  'Paint': /\bpaint|\bwhite\b|metallic/i,
  'Wheels and tyres': /(?<!steering )\bwheels?\b(?! (arch|chock))|tyre|hub ?caps?/i,
  'Lighting': /\blamps?\b|headlamp|headlight|lighting/i,
  'Lighting and visibility': /\blamps?\b|headlamp|headlight|lighting|mirror|wiper|camera/i,
  'Windows and mirrors': /mirror|window|glass|glazed|wiper|windscreen/i,
  'Towing': /\btow/i,
};
const standardFor = (category) => {
  const groups = GROUP_FOR[category];
  const re = KEYWORDS[category];
  if (!groups && !re) return [];
  const trims = equipment.filter((t, i) => i === 0 || /adds/i.test(t.trim));
  return trims.map((t) => ({
    trim: equipment.length > 1 ? t.trim : null,
    items: t.groups
      .filter((g) => (groups ? groups.includes(g.name) : true))
      .flatMap((g) => g.items.map((it) => it.text))
      .filter((txt) => (groups ? true : re.test(txt) && !/shelf|sun visor|instrument/i.test(txt))),
  })).filter((t) => t.items.length);
};
const anchor = (s) => 'spec-' + s;
---
<section class="spec-panel" id="specs">
  <h2>Specs</h2>
  <nav class="spec-nav" aria-label="Spec sections">
    <a href="#spec-overview">Overview</a>
    {equipment.length > 0 && <a href="#spec-equipment">Standard equipment</a>}
    {options.length > 0 && <a href="#spec-options">Optional extras</a>}
    <a href="#spec-full">Full specs</a>
  </nav>
  <h3 class="spec-sub" id="spec-overview">Overview{versions.length > 1 ? ': choose a version' : ''}</h3>
  {versions.length > 1 && (
    <div class="spec-tabs" role="tablist" aria-label="Choose a version">
      {versions.map((v, i) => (
        <button type="button" role="tab" class="spec-tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>{v.name}</button>
      ))}
    </div>
  )}
  {versions.map((v, i) => (
    <ul class="spec-tiles" role="tabpanel" data-i={i} hidden={i !== 0}>
      {Object.entries(v.figures).map(([k, val]) => tile(k, val)).map((t) => (
        <li>
          <span class="spec-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} /></span>
          <span><span class="spec-label">{t.label}</span><strong>{t.v}</strong></span>
        </li>
      ))}
    </ul>
  ))}
  {shared.length > 0 && (
    <>
      <h3 class="spec-sub">Charging and battery{versions.length > 1 ? ', all versions' : ''}</h3>
      <ul class="spec-tiles">
        {shared.map((t) => (
          <li>
            <span class="spec-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} /></span>
            <span><span class="spec-label">{t.label}</span><strong>{t.v}</strong></span>
          </li>
        ))}
      </ul>
    </>
  )}
  {equipment.length > 0 && (
    <div class="spec-block" id="spec-equipment">
      <h3 class="spec-sub">Standard equipment</h3>
      {equipment.length > 1 && (
        <div class="spec-tabs" role="tablist" aria-label="Choose a trim">
          {equipment.map((t, i) => <button type="button" role="tab" class="spec-tab trim-tab" aria-selected={i === 0 ? 'true' : 'false'} data-t={i}>{t.trim}</button>)}
        </div>
      )}
      {equipment.map((t, i) => (
        <div class="trim-panel" data-t={i} hidden={i !== 0}>
          {t.groups.map((g) => (
            <div class="feat-group">
              <h4>{g.name}</h4>
              <ul class="feat-list">
                {g.items.map((it, n) => <li hidden={n >= SHOW} data-more={n >= SHOW ? '' : undefined}>{it.text}</li>)}
              </ul>
              {g.items.length > SHOW && <button type="button" class="link-btn view-all">View all {g.items.length}</button>}
            </div>
          ))}
        </div>
      ))}
    </div>
  )}
  {options.length > 0 && (
    <div class="spec-block" id="spec-options">
      <h3 class="spec-sub">Optional extras</h3>
      <p class="small muted">List prices from the maker, excluding VAT. On a lease, options are added to the monthly cost.</p>
      {options.map((c) => (
        <details class="opt-cat">
          <summary><span>{c.category}</span><span class="opt-count">{c.items.length} {c.items.length === 1 ? 'option' : 'options'}</span></summary>
          {standardFor(c.category).length > 0 && (
            <div class="opt-std">
              <strong>Included as standard</strong>
              {standardFor(c.category).map((t) => (
                <p>{t.trim && <span class="opt-std-trim">{t.trim}: </span>}{t.items.join(', ')}</p>
              ))}
            </div>
          )}
          <p class="opt-paid-label">Paid options</p>
          <ul class="opt-list">
            {c.items.map((it) => (
              <li><span><strong>{it.name}</strong>{it.note && <span class="small muted">{it.note}</span>}</span><span class="opt-price">{it.price}</span></li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  )}
  <details class="spec-full" id="spec-full">
    <summary>View full specs</summary>
    {specs.tables.map((t) => (
      <>
        <h3 class="spec-title">{t.title}</h3>
        <div class="table-wrap">
          <table class="spec-table">
            {t.head.some((h) => h) && <thead><tr>{t.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>}
            <tbody>{t.rows.map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody>
          </table>
        </div>
      </>
    ))}
  </details>
  <ul class="spec-notes small muted">
    {specs.notes?.map((n) => <li>{n}</li>)}
    <li>Source: {specs.sourceLabel}. Every figure is checked against the maker's document before we publish it.</li>
  </ul>
</section>
<script>
  document.querySelectorAll('.spec-panel').forEach((panel) => {
    const tabs = panel.querySelectorAll('.spec-tab:not(.trim-tab)');
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panel.querySelectorAll('.spec-tiles[data-i]').forEach((p) => { p.hidden = p.dataset.i !== tab.dataset.i; });
    }));
    const trims = panel.querySelectorAll('.trim-tab');
    trims.forEach((tab) => tab.addEventListener('click', () => {
      trims.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panel.querySelectorAll('.trim-panel').forEach((p) => { p.hidden = p.dataset.t !== tab.dataset.t; });
    }));
    panel.querySelectorAll('.view-all').forEach((btn) => btn.addEventListener('click', () => {
      btn.previousElementSibling.querySelectorAll('[data-more]').forEach((li) => { li.hidden = false; });
      btn.remove();
    }));
    panel.querySelectorAll('.spec-nav a[href="#spec-full"]').forEach((a) => a.addEventListener('click', () => { panel.querySelector('#spec-full').open = true; }));
  });
</script>
